# ==============================================================================
# ZERACLE TESTNET DEPLOYMENT CONFIGURATION
# ==============================================================================
#
#   *** LOUD WARNING ***
#   Copy this file to `deployments/testnet/.env` and fill in real values.
#   NEVER commit `.env` and NEVER ship it in a release tarball — see
#   devops/production/ec2/scripts/make-release-tarball.sh's exclude list.
#   DEPLOYER_PRIVATE_KEY below controls REAL Sepolia ETH. A leaked key means
#   real funds stolen. Treat this file like a password vault entry.
#
#   A SECOND secret file lives alongside this one:
#   `deployments/testnet/deployer-account.json` — the L2 deployer's own
#   secretKey/salt/signingKey, generated automatically by deploy-testnet.sh
#   (via DEPLOYER_ACCOUNT_FILE, read by v1-l2/scripts/deploy.ts) on the
#   first run and reused on every re-run so the deployer address doesn't
#   change mid-pipeline. It is NOT set here — there's nothing to fill in —
#   it's created for you and chmod'd 600. Same rules apply: BACK IT UP right
#   after it's created, NEVER commit it, NEVER ship it in a release tarball
#   (already excluded in make-release-tarball.sh alongside this file).
#
#   "Testnet" here means the OFFICIAL Aztec testnet (real sequencing,
#   proving, fee infrastructure) plus Sepolia for L1 — never the sandbox.
#   Sepolia chain id is 11155111. The local sandbox L1 (31337) must NEVER
#   appear as TESTNET_L1_RPC_URL; deploy-testnet.sh's preflight guards this.
# ==============================================================================

# --- Required ---

# Sepolia L1 RPC endpoint (Alchemy/Infura/etc — must resolve to chain id
# 11155111). deploy-testnet.sh's preflight calls `cast chain-id` against this
# URL and aborts if it doesn't answer exactly 11155111.
TESTNET_L1_RPC_URL=

# Deployer's L1 private key (0x-prefixed, 32-byte hex). This account pays
# gas for every L1 contract deploy (mock tokens/feeds, TokenPortal bridge)
# and bridges fee-juice for the L2 deploy. MUST be funded with real Sepolia
# ETH ahead of time (get some from a Sepolia faucet). NEVER the anvil dev
# key here — that key is public and only valid for local sandbox use.
DEPLOYER_PRIVATE_KEY=

# URL of an Aztec node/sequencer already running on the OFFICIAL Aztec
# testnet (not a local sandbox PXE). Used to fetch L1 contract addresses
# (Inbox/Rollup/Registry/FeeJuicePortal) via getNodeInfo and to bridge
# fee-juice for the L2 deploy. Ask the Aztec testnet operators / docs for a
# current endpoint.
AZTEC_NODE_URL=

# --- Optional ---

# Minimum deployer L1 ETH balance (in ether) required to proceed past
# preflight. Default 0.5 — enough headroom for L1 deploys + bridge wiring
# + L2 fee-juice bootstrap. Raise if gas prices spike.
MIN_DEPLOYER_BALANCE_ETH=0.5

# Set to 1 to skip the interactive "Type 'deploy' to continue" confirmation
# prompt after preflight (e.g. for CI/scripted runs). Leave unset for
# interactive use — this is a real-money deploy, the prompt is a safety net.
SKIP_CONFIRM=

# Documented fallback ONLY — not implemented yet. If the L2 deploy's
# sandbox-only fee-juice faucet mint is unavailable on the official testnet,
# the pipeline fails loud and points here instead of silently guessing.
# Fill in the canonical SponsoredFPC (fee-paying contract) address for the
# Aztec testnet once known, and see Task 3 of the testnet-deploy-pipeline
# plan before relying on this.
CANONICAL_SPONSORED_FPC_ADDRESS=

# Governance (G3). GOV_PROPOSER is REQUIRED: the Safe that proposes in phase 2; must be a
# deployed contract and must differ from the deployer. Defaults: 180 d transition, 48 h delay.
GOV_PROPOSER=

# D1: REQUIRED break-glass second proposer — a cold EOA or second Safe, so
# loss of the primary Safe (GOV_PROPOSER) cannot freeze governance after the
# transition. Must differ from both the deployer and GOV_PROPOSER. No code
# check — an EOA is expected here, unlike GOV_PROPOSER.
GOV_PROPOSER_2=

# D2: GOV_GUARDIAN is now REQUIRED and must be a separate key from the
# deployer (no default — the sandbox script still defaults it to the
# deployer, but a testnet deploy must not).
GOV_GUARDIAN=

GOV_TRANSITION_SECONDS=15552000
GOV_TIMELOCK_DELAY=172800

# D5: resumable deploy. Optional — leave all three unset for a fresh
# governance deploy. If set, ALL THREE must be set together, and each must
# already have code on Sepolia; deploy-testnet.sh then reuses them instead
# of deploying a new GovernanceAuthority/ZeracleTimelock/UpgradeValidator.
# GOV_AUTHORITY=
# GOV_TIMELOCK=
# GOV_VALIDATOR=
